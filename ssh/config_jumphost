Host apps-jump-kb apps-jump-kb.is.ed.ac.uk
  User UUN
  ProxyCommand none
Host apps-jump-at apps-jump-at.is.ed.ac.uk
  User UUN
  ProxyCommand none
Match originalhost apps-jump-kb-connect
  HostName apps-jump-kb.is.ed.ac.uk
  ProxyCommand none
  User UUN
  ControlPath ~/.ssh/apps-jump-kb_socket
  RemoteCommand none
  RequestTTY no
  ControlMaster yes
  ControlPersist yes
  GatewayPorts yes
  ExitOnForwardFailure yes
  DynamicForward 11080
Match originalhost apps-jump-kb-socket
  HostName apps-jump-kb.is.ed.ac.uk
  ProxyCommand none
  User UUN
  ControlPath ~/.ssh/apps-jump-kb_socket
  RemoteCommand none
  RequestTTY no
